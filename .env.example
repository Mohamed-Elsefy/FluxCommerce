# Local development environment variables for docker-compose.
# Copy this file to .env and adjust the values for your machine.
# .env is gitignored; never commit real credentials.

# SQL Server (meets SQL Server password complexity requirements)
MSSQL_SA_PASSWORD=StrongPassw0rd2026

# RabbitMQ management user
RABBITMQ_DEFAULT_USER=fluxcommerce
RABBITMQ_DEFAULT_PASS=fluxcommerce_dev
RABBITMQ_DEFAULT_VHOST=/
