# Local development environment variables for docker-compose.
# Copy this file to .env and adjust the values for your machine.
# .env is gitignored; never commit real credentials.

# SQL Server (must meet SQL Server password complexity requirements)
# Replace with a strong password of your own before copying to .env.
MSSQL_SA_PASSWORD=CHANGE_ME_StrongPassword123!

# RabbitMQ management user
RABBITMQ_DEFAULT_USER=fluxcommerce
# Replace with a password of your own before copying to .env.
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RabbitMQ_Pass123
RABBITMQ_DEFAULT_VHOST=/

# Stripe (test mode) — required only for the optional `stripe-cli` profile.
# Copy your Secret key (sk_test_...) from Stripe Dashboard (test mode) into .env.
# Never commit real keys; .env is gitignored.
STRIPE_SECRET_KEY=CHANGE_ME_sk_test_xxx
