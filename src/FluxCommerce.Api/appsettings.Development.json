    "ModuleConnections": {
      "Catalog": "Server=localhost,1433;Database=FluxCommerce_Catalog;User Id=sa;TrustServerCertificate=True;MultipleActiveResultSets=true",
      "Cart": "Server=localhost,1433;Database=FluxCommerce_Cart;User Id=sa;TrustServerCertificate=True;MultipleActiveResultSets=true",
      "Orders": "Server=localhost,1433;Database=FluxCommerce_Orders;User Id=sa;TrustServerCertificate=True;MultipleActiveResultSets=true",
      "Inventory": "Server=localhost,1433;Database=FluxCommerce_Inventory;User Id=sa;TrustServerCertificate=True;MultipleActiveResultSets=true",
      "Payments": "Server=localhost,1433;Database=FluxCommerce_Payments;User Id=sa;TrustServerCertificate=True;MultipleActiveResultSets=true",
      "Identity": "Server=localhost,1433;Database=FluxCommerce_Identity;User Id=sa;TrustServerCertificate=True;MultipleActiveResultSets=true"
