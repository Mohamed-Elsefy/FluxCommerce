{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },

  "Database": {
    "ConnectionString": "Server=localhost,1433;Database=FluxCommerce;User Id=sa;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "EnableDetailedErrors": true,
