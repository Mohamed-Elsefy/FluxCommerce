{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },

  "Database": {
    "ConnectionString": "Server=localhost;Database=FluxCommerce;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": true,
    "ModuleConnections": {
      "Catalog": "Server=localhost;Database=FluxCommerce_Catalog;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
      "Cart": "Server=localhost;Database=FluxCommerce_Cart;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
      "Orders": "Server=localhost;Database=FluxCommerce_Orders;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
      "Inventory": "Server=localhost;Database=FluxCommerce_Inventory;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
      "Payments": "Server=localhost;Database=FluxCommerce_Payments;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
    }
  },

  "MessageBroker": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },

  "Cache": {
    "ConnectionString": "localhost:6379"
  }
}
