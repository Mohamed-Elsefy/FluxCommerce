{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": []
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },

  "Database": {
    "ConnectionString": "",
    "ModuleConnections": {},
    "MaxRetryCount": 3,
    "CommandTimeoutSeconds": 30,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  },

  "MessageBroker": {
    "Host": "",
    "Port": 5672,
    "Username": "",
    "Password": "",
    "VirtualHost": "/",
    "RetryCount": 5
  },

  "Cache": {
    "ConnectionString": "",
    "DefaultExpirationMinutes": 60
  },

  "Cart": {
    "KeyNamespace": "cart",
    "DefaultTtlMinutes": 10080
  },

  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "ClockSkewMinutes": 5
  },

  "Inventory": {
    "ReservationExpiration": {
      "Interval": "00:00:30",
      "BatchSize": 100
    }
  },

  "Email": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "",
    "UseSsl": true,
    "FrontendBaseUrl": ""
  },

  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": ""
  },

  "Identity": {
    "Seeder": {
      "Enabled": false
    }
  }
}
